# PC마다 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 git에 올리지 않는다)
# 비워둔 설정값은 config.py의 기본값(릴리스 서버 14.38.199.190 기준)을 쓴다.

# ---------- 비밀값 (필수) ----------
ANTHROPIC_API_KEY=
# 메일 발송(SMTP)
MAIL_ID=
MAIL_PW=
# 메일 수신(MS Graph)
CLIENT_ID=
TENANT_ID=

# ---------- LLM / 임베딩 ----------
# LLM_BASE_URL=http://14.38.199.190:9090/v1
# 릴리스 서버에서 Docker로 띄울 때는 같은 서버의 vLLM을 호스트로 부른다:
# LLM_BASE_URL=http://host.docker.internal:9090/v1
# LLM_MODEL=qwen3.8-flash-next
# CLAUDE_MODEL=claude-sonnet-5
# EMBEDDING_MODEL=bge-m3:latest
# Ollama 주소 (docker-compose에서는 ollama 컨테이너로 이미 지정됨, 로컬 실행 시에만 사용)
# OLLAMA_HOST=http://127.0.0.1:11434

# ---------- OCR ----------
# llm: 기존 LLM 서버 / vlm: 로컬 PaddleOCR-VL (변경 후 앱 재시작)
OCR_BACKEND=llm
# 기본 HOME은 프로젝트와 같은 부모 폴더의 paddleocr_vl_test
# PADDLEOCR_HOME=C:/TG_AI_DEV/paddleocr_vl_test
# PADDLEOCR_PYTHON=C:/TG_AI_DEV/paddleocr_vl_test/.venv/Scripts/python.exe
# PADDLEOCR_VL_MODEL_DIR=C:/TG_AI_DEV/paddleocr_vl_test/models/paddlex/official_models/PaddleOCR-VL-1.6
# PADDLEOCR_LAYOUT_MODEL_DIR=C:/TG_AI_DEV/paddleocr_vl_test/models/paddlex/official_models/PP-DocLayoutV3
# PADDLEOCR_DEVICE=gpu:0
# 요청당 제한 시간 (첫 요청의 모델 로딩 시간 포함)
# PADDLEOCR_TIMEOUT=300
# 앱 프로젝트 안의 캐시/로그 폴더. 원본 모델 폴더는 수정하지 않음.
# PADDLEOCR_CACHE_DIR=temp/paddleocr

# ---------- 메일 ----------
# 검토 요청 메일 속 링크의 기준 주소. 개발 PC에서는 개발 PC 주소로 바꾼다.
# PUBLIC_BASE_URL=http://14.38.199.190:9092
# REVIEWER_EMAIL=dongwook.kim@trigem.co.kr

# ---------- 청킹 ----------
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200

# ---------- 로그 ----------
# 로그 파일 폴더 (상대 경로면 프로젝트 루트 기준)
# LOG_DIR=logs
# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 날짜별 로그 파일 보관 일수
# LOG_BACKUP_DAYS=30
