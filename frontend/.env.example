# 백엔드(FastAPI) 주소.
# 기본은 same-origin이며, 개발 중에는 vite proxy(vite.config.ts)가 127.0.0.1:8000 으로 넘긴다.
# 백엔드가 다른 호스트/포트에 있을 때만 설정한다.
# VITE_API_BASE=http://127.0.0.1:8000

# vite dev proxy가 바라볼 백엔드 (기본 http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# OCR 서버 (기본: 지금 페이지를 연 호스트의 8082 포트)
# VITE_OCR_API_BASE=http://127.0.0.1:8082
